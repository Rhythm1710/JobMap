# Same Postgres database the Next.js app uses. Prefer the direct connection
# string (not the PgBouncer transaction pooler). postgres:// is accepted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobmap

# Shared with the Next.js app. Long random string. Sent as Authorization: Bearer.
SERVICE_SECRET=replace-with-a-long-random-string

# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application). Enable the Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirects the browser here. This is the Next.js app, not the Python
# service, so the httpOnly connect cookie is sent and checked.
# Must match an authorized redirect URI on the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Where to send the browser after connect. The Next.js origin, no trailing path.
APP_URL=http://localhost:3000

# Email classification. Rules run first. The model only sees mail the rules are
# unsure about. Leave LLM_API_KEY empty to stay rules-only.
#
# Default: Groq free tier, Llama 3.3 70B. One key from https://console.groq.com/keys
# (no card). It is OpenAI-compatible and needs no extra headers. If you hit 429s,
# switch LLM_MODEL to llama-3.1-8b-instant, which has a higher free rate limit.
# The client retries 429s, caps calls per sync, and falls back to the rules.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_BODY_CHARS=1200
LLM_MAX_CALLS_PER_RUN=8

# OpenRouter free models: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=

# Google Gemini OpenAI-compatible endpoint: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=

# Mark applied or assessment rows ghosted after this many days with no email.
# 0 turns it off. A later email moves the row back to that email's status.
# Rows whose status the owner set by hand are left alone.
GHOST_AFTER_DAYS=30

# How far back the first import searches, and how many messages one run will fetch.
GMAIL_LOOKBACK_DAYS=180
GMAIL_MAX_MESSAGES_PER_RUN=200

# Set above 0 to sync inside this process. Leave at 0 when a Railway cron calls
# POST /internal/cron/sync so the import does not run twice.
SYNC_INTERVAL_MINUTES=0
