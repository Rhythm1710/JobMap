# Postgres. On Vercel this can be the pooled connection string.
# Run `npx prisma migrate deploy` with a direct (non-pooled) URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobmap

# Clerk. This app uses Clerk's hosted sign-in. There is no custom login page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Python ingestion service (local uvicorn or Railway). Server-only; do not prefix with NEXT_PUBLIC_.
PYTHON_SERVICE_URL=http://localhost:8000
# Must match SERVICE_SECRET on the Python service.
SERVICE_SECRET=replace-with-a-long-random-string
